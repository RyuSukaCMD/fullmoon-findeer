# ============================================================================
#  Full Moon Finder — environment configuration
# ============================================================================
#  This file is used for LOCAL development (Vite + the Node server). On Vercel
#  you add these same values as Environment Variables in the project dashboard
#  (Project → Settings → Environment Variables). Copy this file to `.env` and
#  edit values — never commit real secrets to a public repo.
# ============================================================================

# ---------------------------------------------------------------------------
#  CLIENT (Vite) — must use the VITE_ prefix to be bundled into the frontend
# ---------------------------------------------------------------------------

# The MAIN page URL — the single iframe source the finder's browser loads, and
# the default address of address Page 1. This is the one you can override live
# in the Studio → "Finder settings".
VITE_MAIN_PAGE_URL=https://www.roblox.com/games/2753915549/Blox-Fruits

# Optional: address-page defaults (the address bar shows these in order as the
# frame redirects). Leave blank if you only want the main page.
# VITE_ADDR_PAGE_1=https://www.roblox.com/games/2753915549/Blox-Fruits
# VITE_ADDR_PAGE_2=
# VITE_ADDR_PAGE_3=

# ---------------------------------------------------------------------------
#  SERVER (Node / Express) — the API side
# ---------------------------------------------------------------------------

# The first user (owner/admin) is created on first boot with these credentials.
# IMPORTANT: change these before deploying anywhere public.
ADMIN_USERNAME=Chaeulso
ADMIN_PASSWORD=Chaeulkeren67

# Backend override for the MAIN page URL (server-side mirror of VITE_MAIN_PAGE_URL).
# The DB value takes precedence once saved from the Studio.
MAIN_PAGE_URL=https://www.roblox.com/games/2753915549/Blox-Fruits

# Local API port (used by `npm run dev` / `npm start`). Not used on Vercel.
PORT=5180

# Where the JSON persistence file lives.
#   - default: server/data (local, durable)
#   - Vercel serverless: /tmp (ephemeral per instance — see TUTORIAL.md)
# DATA_DIR=./server/data

# NODE_ENV=development
# NODE_ENV=production

# ---------------------------------------------------------------------------
#  VERCEL (optional — mostly handled automatically)
# ---------------------------------------------------------------------------

# Vercel automatically injects VERCEL=1 during builds/runs, which makes the
# server use the ephemeral /tmp storage. No action needed.
# Link for preview/deploy if you want to pin it:
# VERCEL_PROJECT_PRODUCTION_URL=https://your-project.vercel.app

# ---------------------------------------------------------------------------
#  DURABLE DATABASE — Supabase (recommended for Vercel)
# ---------------------------------------------------------------------------
#  When BOTH of these are set, all state (users, pages, views, sessions) is
#  mirrored to Supabase so it survives serverless cold starts and you stay
#  logged in across reloads/instances. If either is empty, the app falls back
#  to the JSON file (/tmp on Vercel, ephemeral).
#
#  How to set up:
#   1. Create a project at https://supabase.com → copy the Project URL.
#   2. Go to Settings → API → copy the **service_role** key (server-side only;
#      never expose it to the browser — the key here is only read by the API).
#   3. In the SQL editor, create ONE table:
#
#        create table if not exists records (
#          key text primary key,
#          data jsonb,
#          updated_at timestamptz default now()
#        );
#        alter table records enable row level security;
#
#      (No public read needed — our server uses the service role key.)
#
#   4. Add these two env vars to Vercel (or this .env for local dev):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (Fallback to the anon key if you prefer a lower-privilege key:
#SUPABASE_ANON_KEY=)
